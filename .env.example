# Required
OPENAI_API_KEY=

# Optional
# Comma-separated e-mails that can see the admin health panel
ADMIN_EMAILS=
# Set to 1 to unlock the premium report sections without a paid plan (useful for demos)
UNLOCK_ALL_PREMIUM_PREVIEW=0

# Only needed when a separate marketing frontend signs users in and hands them over
AUTH_BRIDGE_SECRET=
AUTH_BRIDGE_ISSUER=convaudit-frontend
AUTH_BRIDGE_AUDIENCE=convaudit-streamlit
FRONTEND_BASE_URL=http://localhost:3000
LEGAL_SITE_BASE_URL=http://localhost:3000

# Checkout links shown on the upgrade panel
IYZICO_CHECKOUT_URL=
STRIPE_CHECKOUT_URL=
